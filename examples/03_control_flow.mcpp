// if / else-if / else, while, for, do-while, break, continue.

int main() {
    int score = 72;

    if (score >= 90) {
        print("Grade: A");
    } else if (score >= 75) {
        print("Grade: B");
    } else if (score >= 60) {
        print("Grade: C");
    } else {
        print("Grade: F");
    }

    print("-- for loop, skipping multiples of 3 --");
    for (int i = 1; i <= 10; i = i + 1) {
        if (i % 3 == 0) {
            continue;
        }
        print(i);
    }

    print("-- while loop with a break --");
    int n = 0;
    while (true) {
        if (n == 5) {
            break;
        }
        print("n = ", n);
        n++;
    }

    print("-- do-while: runs body at least once --");
    int j = 0;
    do {
        print("j = ", j);
        j++;
    } while (j < 3);

    return 0;
}
