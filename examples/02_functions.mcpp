// Functions, parameters, and recursion.

int add(int x, int y) {
    return x + y;
}

int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

int fibonacci(int n) {
    if (n < 2) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

int main() {
    print("add(4, 7)     = ", add(4, 7));
    print("factorial(6)  = ", factorial(6));

    int i = 0;
    while (i < 8) {
        print("fibonacci(", i, ") = ", fibonacci(i));
        i++;
    }

    return 0;
}
